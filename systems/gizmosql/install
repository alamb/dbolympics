#!/bin/bash
set -eu

HOME="${HOME:-/root}"
export HOME

sudo apt-get update -y
sudo apt-get install -y --no-install-recommends curl unzip netcat-openbsd

# the release, as `version` in system.toml
GIZMOSQL=v1.42.0
if ! command -v gizmosql_server >/dev/null 2>&1; then
    curl -fsSL https://install.gizmosql.com/install.sh | HOME="$HOME" sh -s -- --version "$GIZMOSQL"
    sudo install -m 0755 "$HOME/.local/bin/gizmosql_server" "$HOME/.local/bin/gizmosql_client" /usr/local/bin/
fi
gizmosql_server --version

# The server installs DuckDB's icu extension when it starts, which needs the network: start it
# once now, so the extension is in the image ...
tmp=$(mktemp -d)
(cd "$tmp" && GIZMOSQL_PASSWORD=install gizmosql_server --username install --database-filename install.duckdb >server.log 2>&1 &)
for _ in $(seq 1 60); do
    nc -z localhost 31337 2>/dev/null && break
    sleep 1
done
nc -z localhost 31337 || { cat "$tmp/server.log" >&2; exit 1; }
# ... and the extensions the benchmark needs (the schema has JSON columns, the data is Parquet)
GIZMOSQL_USER=install GIZMOSQL_PASSWORD=install gizmosql_client -q --bail -c "INSTALL json; INSTALL parquet;"
pkill -x gizmosql_server || true
sleep 2
rm -rf "$tmp"

# the query program (query.rs), built here with a Rust toolchain that is removed again
cd /system
sudo apt-get update -y
sudo apt-get install -y --no-install-recommends build-essential
curl -fsSL --retry 10 https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain 1.99.0
"$HOME/.cargo/bin/cargo" build --release --locked
install -m 0755 target/release/query query
rm -rf target "$HOME/.cargo" "$HOME/.rustup"
