#!/bin/bash
# Start the GizmoSQL server (DuckDB behind Arrow Flight SQL) with the query program's user, then
# the query program.
set -eu
mkdir -p db
GIZMOSQL_PASSWORD=bench nohup gizmosql_server --username bench --database-filename db/dbo.duckdb >> server.log 2>&1 &
echo $! > server.pid

# the query program, for the whole run: the runner's protocol on /run/dbo/dbo.sock
nohup ./query >/run/dbo/query.log 2>&1 &
echo $! > query.pid
