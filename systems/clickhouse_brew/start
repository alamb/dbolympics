#!/bin/bash
# Starts ClickHouse; the Umbra container is started by the benchmark runner (system.toml).
set -e

# The threads and memory of this run (the server would otherwise size itself), as systems/clickhouse
sudo tee /etc/clickhouse-server/config.d/zz-limits.yaml >/dev/null <<YAML
max_server_memory_usage: $((DBO_MEMORY_BYTES * 9 / 10))
YAML
sudo tee /etc/clickhouse-server/users.d/zz-limits.yaml >/dev/null <<YAML
profiles:
  default:
    max_threads: $DBO_THREADS
YAML

sudo clickhouse start

# the query program, for the whole run: the runner's protocol on /run/dbo/dbo.sock
nohup ./query >/run/dbo/query.log 2>&1 &
echo $! > query.pid
