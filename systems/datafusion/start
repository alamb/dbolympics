#!/bin/bash
# DataFusion runs inside the query program, with the run's threads and a memory pool of 80% of its
# memory (room left for what the pool does not track).
set -e
mkdir -p db

# the query program, for the whole run: the runner's protocol on /run/dbo/dbo.sock
nohup ./query /system/db "$DBO_THREADS" $((DBO_MEMORY_BYTES * 8 / 10)) >/run/dbo/query.log 2>&1 &
echo $! > query.pid
