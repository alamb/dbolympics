#!/bin/bash
# the query program
if [ -f query.pid ]; then
    kill "$(cat query.pid)" 2>/dev/null || true
    rm -f query.pid
fi

# SIGTERM shuts hyperd down cleanly.
pid=$(cat server.pid)
kill "$pid" 2>/dev/null || true
for _ in $(seq 1 120); do
    kill -0 "$pid" 2>/dev/null || exit 0
    sleep 1
done
kill -9 "$pid" 2>/dev/null || true
