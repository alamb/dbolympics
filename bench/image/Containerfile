# The base of every system's container: Ubuntu with the few tools the install scripts rely on.
# The system's directory comes into /system, where its install runs (bench/src/podman.rs).
FROM docker.io/library/ubuntu:26.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update -y && apt-get install -y --no-install-recommends sudo curl ca-certificates python3 python3-venv gnupg && rm -rf /var/lib/apt/lists/*
WORKDIR /system
